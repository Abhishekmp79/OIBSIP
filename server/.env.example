# ─────────────────────────────────────────────
# Slice House — Backend Environment Variables
# Copy this file to `.env` and fill in real values
# ─────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# Frontend origin (for CORS + email links)
FRONTEND_URL=http://localhost:5173

# MongoDB — replace <user>, <password>, <cluster> with your Atlas values
# Local example:  mongodb://127.0.0.1:27017/slice_house
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/slice_house?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/slice_house

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Razorpay (Test Mode — from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# SMTP (Gmail App Password — https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_16_char_app_password

# Default admin account (created by `npm run seed`)
ADMIN_EMAIL=admin@slicehouse.com
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Slice House Admin

# Recipient for low-stock alerts (usually same as ADMIN_EMAIL)
ALERT_RECIPIENT=admin@slicehouse.com

# Email "from" address
MAIL_FROM="Slice House" <no-reply@slicehouse.com>
